/target

# Written next to the binary when plv runs from this folder (`cargo run`):
# saved UI settings and the local HTTPS certificate authority and keys.
/settings.json
/settings.json.tmp
/ca.key
/ca.crt
/ca.pem
/server.key
/server.crt
/server.names

# Base and built Raspberry Pi OS images (build_image.sh).
/images

# Impeccable design tooling: per-machine consent and the hook cache stay local.
/.impeccable/config.local.json
/.impeccable/hook.cache.json

# Svelte build tooling (ui-src/); its output ui/dist/ is committed.
/ui-src/node_modules
